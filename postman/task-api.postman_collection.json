              "mode": "raw",
              "raw": "{\n  \"title\": \"Overdue task\",\n  \"priority\": \"high\",\n  \"due_date\": \"{{pastDate}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Create - due today",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('defaults to medium priority', () => pm.expect(pm.response.json().task.priority).to.eql('medium'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Due today task\",\n  \"due_date\": \"{{todayDate}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Create - future (saves taskId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('status is PENDING', () => pm.expect(pm.response.json().task.status).to.eql('PENDING'));",
                  "pm.collectionVariables.set('taskId', pm.response.json().task.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Future task\",\n  \"priority\": \"low\",\n  \"description\": \"Has a description\",\n  \"due_date\": \"{{futureDate}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Create - no due date",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('no due date still counts as PENDING', () => pm.expect(pm.response.json().task.status).to.eql('PENDING'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Someday task\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "List all",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const tasks = pm.response.json().tasks;",
                  "pm.test('every task belongs to me', () => {",
                  "  const me = tasks[0].user_id;",
                  "  tasks.forEach(t => pm.expect(t.user_id).to.eql(me));",
                  "});",
                  "pm.test('tasks with no due date sort last', () => {",
                  "  const first = tasks.findIndex(t => t.due_date === null);",
                  "  if (first === -1) return;",
                  "  const trailing = tasks.slice(first).every(t => t.due_date === null);",
                  "  pm.expect(trailing, 'every task after the first undated one is also undated').to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"]
            }
          }
        },
        {
          "name": "Filter ?status=OVERDUE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('all returned are OVERDUE', () => pm.response.json().tasks.forEach(t => pm.expect(t.status).to.eql('OVERDUE')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=OVERDUE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "OVERDUE" }]
            }
          }
        },
        {
          "name": "Filter ?status=pending (lowercase works)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('all returned are PENDING', () => pm.response.json().tasks.forEach(t => pm.expect(t.status).to.eql('PENDING')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
