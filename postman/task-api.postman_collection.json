                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('status is OVERDUE', () => pm.expect(pm.response.json().task.status).to.eql('OVERDUE'));",
                  "pm.collectionVariables.set('deleteId', pm.response.json().task.id);"
                ]
              }
