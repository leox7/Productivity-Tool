            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const today = new Date().toISOString().slice(0, 10);",
                  "pm.test('all due today (UTC)', () => pm.response.json().tasks.forEach(t => pm.expect(t.due_date.slice(0, 10)).to.eql(today)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?due=today",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "due", "value": "today" }]
            }
          }
        },
        {
          "name": "Filter ?due=week",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?due=week",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [{ "key": "due", "value": "week" }]
            }
          }
        },
        {
          "name": "Get one",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is the task I asked for', () => pm.expect(String(pm.response.json().task.id)).to.eql(String(pm.collectionVariables.get('taskId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update (partial PATCH)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().task;",
                  "pm.test('title changed', () => pm.expect(t.title).to.eql('Updated title'));",
                  "pm.test('untouched fields preserved', () => pm.expect(t.description).to.eql('Has a description'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"priority\": \"high\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Complete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().task;",
                  "pm.test('completed_at is set', () => pm.expect(t.completed_at).to.not.eql(null));",
                  "pm.test('status flips to COMPLETED', () => pm.expect(t.status).to.eql('COMPLETED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", "complete"]
            }
          }
        },
        {
          "name": "Delete",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{deleteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{deleteId}}"]
            }
          }
        },
        {
          "name": "Get deleted -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{deleteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{deleteId}}"]
            }
          }
        }
      ]
    },
